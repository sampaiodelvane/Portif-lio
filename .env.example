# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA versione o .env / .env.local — o .gitignore e o hook de pre-commit bloqueiam.
#
# Variáveis com prefixo VITE_ são embutidas no bundle do navegador e, portanto, PÚBLICAS.
# Não coloque aqui nenhum segredo de servidor (ex.: service_role do Supabase).

# --- GitHub (Fase 3) ---
# Usuário cujos repositórios públicos serão listados.
VITE_GITHUB_USERNAME=

# --- Supabase (Fase 4) — Auth + tabelas contact_messages e featured_projects ---
# A anon key é pública por design; a segurança vem das políticas RLS no banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contato: o formulário envia pelo FormSubmit para o e-mail de src/content/contact-inbox.ts
# (sem conta nem chave). Nada a configurar aqui.
